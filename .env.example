# ============================================
# Backend Configuration (.env)
# ============================================
# Copy this file to .env and fill in your actual values

# Firebase Firestore Credentials
# Option 1: Path to JSON file (local development)
# FIRESTORE_CREDENTIALS=./backend/firebase_credentials.json

# Option 2: Full JSON as string (production on Railway/Render)
# FIRESTORE_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"..."}

FIRESTORE_CREDENTIALS=./backend/firebase_credentials.json

# LiveKit Configuration
# Get from: https://cloud.livekit.io
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=your_livekit_url

# ============================================
# Frontend Configuration
# ============================================
# Set in frontend/settings.html when deployed
# Or via browser console: localStorage.setItem('API_BASE_URL', 'https://...')

# For LOCAL development:
# API_BASE_URL=http://127.0.0.1:8000

# For PRODUCTION (Railway/Render backend):
# API_BASE_URL=https://your-backend.railway.app
