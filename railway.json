{
    "build": {
        "builder": "BUILDPACKS"
    },
    "buildpacks": [
        {
            "id": "heroku/python"
        }
    ],
    "env": {
        "PYTHONUNBUFFERED": {
            "description": "Ensure Python output is not buffered",
            "value": "true"
        },
        "PORT": {
            "description": "Port for the application",
            "value": "8000"
        }
    }
}